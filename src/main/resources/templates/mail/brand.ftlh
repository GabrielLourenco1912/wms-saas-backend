<#ftl output_format="HTML" auto_esc=true strip_whitespace=true>
<#-- Tokens da identidade visual WMS SaaS, mantidos com os recursos de e-mail. -->
<#assign ink="#14251E">
<#assign primary="#176B48">
<#assign accent="#D1F878">
<#assign soft="#E7F4EC">
<#assign paper="#F5F6F0">
<#assign surface="#FFFFFF">
<#assign text="#18251F">
<#assign muted="#5C6B62">
<#assign inverse="#F5F6F0">
<#assign inverseMuted="#B6C4B8">
<#assign border="#DCE3DA">
<#assign warning="#855400">
<#assign warningBackground="#FFF2CF">
<#assign name="WMS SaaS">
<#assign descriptor="Gestão de armazéns">
<#assign tagline="Cada movimento, sob controle.">
<#assign authorName="Gabriel Lourenço">
<#assign authorLabel="Desenvolvido por">
<#assign portfolio="https://lourencogabriel.dev/">
